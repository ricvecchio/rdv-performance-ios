      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Density workout: keep sets unbroken and minimize rest at transitions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento de densidad: mantener las series sin interrupción y minimizar el descanso en las transiciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino de densidade: o objetivo é manter séries unbroken e minimizar descanso nas transições."
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.jack_2010.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
