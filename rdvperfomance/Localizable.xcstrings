      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intense rounds. The challenge is to stay consistent without completely breaking down at transitions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento con rondas intensas. El desafío es mantener la constancia sin agotarse por completo en las transiciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino com rounds intensos. O desafio é manter consistência sem quebrar completamente nas transições."
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.hamilton_2013.block.2.name" : {
