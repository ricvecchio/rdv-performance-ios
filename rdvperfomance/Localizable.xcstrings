    "default_workout.crossfit.heroTributeWorkouts.jt_2005.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A descending workout that increases fatigue in pushing movements. Control the start to avoid early failure on handstand push-ups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento descendente que aumenta la fatiga en los movimientos de empuje. Controlar el inicio para evitar el fallo prematuro en handstand push-ups."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino descendente que aumenta a fadiga dos movimentos de empurrar. A estratégia é controlar o início para evitar falha precoce nos handstand push-ups."
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.jt_2005.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
