    "default_workout.crossfit.heroTributeWorkouts.riley_2013.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An endurance workout. Keep burpees at a steady pace without sprinting and burning out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento de resistencia. Mantener los burpees a ritmo constante, sin esprintar y agotarse."
