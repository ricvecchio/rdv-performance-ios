    "default_workout.academia.ombros.ombros_padrao.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Shoulder mobility (circles): 10 in each direction\n• 2x12 light External Rotations (resistance band)\n• 2x12 light Lateral Raises"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Movilidad de hombros (círculos): 10 en cada dirección\n• 2x12 Rotación Externa (banda elástica) ligera\n• 2x12 Elevación Lateral ligera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mobilidade de ombro (círculos): 10 para cada lado\n• 2x12 Rotação externa (elástico) leve\n• 2x12 Elevação lateral leve"
          }
        }
      }
    },
    "default_workout.academia.ombros.ombros_padrao.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.academia.ombros.ombros_padrao.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Avoid raising your shoulders (trapezius) during lateral raises\n• Control and range of motion without pain\n• Prioritize the rear deltoids for balance"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Evita elevar los hombros (trapecio) en las elevaciones laterales\n• Control y rango de movimiento sin dolor\n• Prioriza el deltoides posterior para el equilibrio"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Evite elevar ombros (trapézio) nas laterais\n• Controle e amplitude sem dor\n• Priorize deltoide posterior para equilíbrio"
          }
        }
      }
    },
    "default_workout.academia.ombros.ombros_padrao.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.academia.ombros.ombros_padrao.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Shoulder Press (dumbbell/barbell) — 4x6–10\n2) Lateral Raise — 4x12–15\n3) Front Raise (dumbbell) — 3x10–12\n4) Reverse Fly (machine/cable) — 4x12–20\n5) Face Pull — 3x12–20\nRest: 45–75s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Press de Hombros (mancuerna/barra) — 4x6–10\n2) Elevación Lateral — 4x12–15\n3) Elevación Frontal (mancuerna) — 3x10–12\n4) Aperturas Inversas (máquina/cable) — 4x12–20\n5) Face Pull — 3x12–20\nDescanso: 45–75s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Desenvolvimento (halter/barra) — 4x6–10\n2) Elevação Lateral — 4x12–15\n3) Elevação Frontal (halter) — 3x10–12\n4) Crucifixo Inverso (máquina/cabo) — 4x12–20\n5) Face Pull — 3x12–20\nDescanso: 45–75s"
          }
        }
      }
    },
    "default_workout.academia.ombros.ombros_padrao.block.3.name" : {
      "extractionState" : "manual",
      "localizations" : {
