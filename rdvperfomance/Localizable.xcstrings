    "default_workout.crossfit.heroTributeWorkouts.jack_2010.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder mobility\n2 easy rounds:\n• 8 Light Push press\n• 10 Light KB swings\n• 8 Box step-ups"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad de hombros\n2 rondas suaves:\n• 8 Push press ligero\n• 10 KB swings ligeros\n• 8 Box step-ups"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade de ombros\n2 rounds leves:\n• 8 Push press leve\n• 10 KB swings leves\n• 8 Box step-ups"
          }
        }
      }
    },
