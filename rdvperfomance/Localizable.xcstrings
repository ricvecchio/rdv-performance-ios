      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoiding early HSPU failure is fundamental. Small, consistent sets preserve pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar el fallo prematuro en HSPU es fundamental. Las series pequeñas y constantes preservan el ritmo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar falha precoce no HSPU é fundamental. Manter séries pequenas e constantes preserva o ritmo."
          }
        }
      }
    },
