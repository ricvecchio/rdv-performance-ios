    "settings.legal.help.introduction" : {
      "comment" : "Stable semantic key for: Bem-vindo à Central de Ajuda. Este aplicativo foi desenvolvido para facilitar o acompanhamento de treinos físicos entre alunos e treinadores, de forma simples e organizada. Aqui você encontra orientações básicas sobre o uso do app.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the Help Center.\nThis application was developed to make it easier for students and coaches to track physical training in a simple and organized way. Here you can find basic guidance on how to use the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido al Centro de ayuda.\nEsta aplicación fue desarrollada para facilitar el seguimiento de los entrenamientos físicos entre alumnos y entrenadores, de manera sencilla y organizada. Aquí encontrarás orientaciones básicas sobre el uso de la aplicación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo à Central de Ajuda.\nEste aplicativo foi desenvolvido para facilitar o acompanhamento de treinos físicos entre alunos e treinadores, de forma simples e organizada. Aqui você encontra orientações básicas sobre o uso do app."
          }
        }
      }
    },
