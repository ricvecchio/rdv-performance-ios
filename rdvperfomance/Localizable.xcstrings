    "default_workout.crossfit.heroTributeWorkouts.hamilton_2013.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder and hip mobility\n5 min of easy cardio (rowing/running)\n2 easy rounds:\n• 10 Push-ups\n• 5 Pull-ups (or ring rows)\n• 200 m easy run"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad de hombros y cadera\n5 min de cardio suave (remo/carrera)\n2 rondas suaves:\n• 10 Push-ups\n• 5 Pull-ups (o ring rows)\n• 200 m carrera suave"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade de ombros e quadril\n5 min de cardio leve (remo/corrida)\n2 rounds leves:\n• 10 Push-ups\n• 5 Pull-ups (ou ring rows)\n• 200 m corrida leve"
          }
        }
      }
    },
