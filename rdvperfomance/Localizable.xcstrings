    "default_workout.academia.pernas.pernas_b.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min of easy cycling\n• 2x12 Glute Bridges\n• 2x10 Good mornings (light)\n• 1–2 light sets of the main exercise"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min de bicicleta suave\n• 2x12 Puente de Glúteos\n• 2x10 Good morning (ligero)\n• 1–2 series ligeras del ejercicio principal"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min bike leve\n• 2x12 Ponte de glúteos\n• 2x10 Good morning (leve)\n• 1–2 séries leves do exercício principal"
          }
        }
      }
    },
    "default_workout.academia.pernas.pernas_b.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
