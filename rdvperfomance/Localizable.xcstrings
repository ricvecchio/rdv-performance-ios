    "default_workout.crossfit.heroTributeWorkouts.randy_2008.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder and ankle mobility\nTechnique for snatch with PVC\n3 progressive sets:\n• 5 Light Power snatch\n• 3 Moderate Power snatch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad de hombros y tobillos\nTécnica de snatch con PVC\n3 series progresivas:\n• 5 Power snatch ligero\n• 3 Power snatch moderado"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade de ombros e tornozelos\nTécnica de snatch com PVC\n3 séries progressivas:\n• 5 Power snatch leve\n• 3 Power snatch moderado"
          }
        }
      }
    },
