    },
    "default_workout.crossfit.heroTributeWorkouts.jt_2005.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Keep the core active in HSPU\n• Keep elbows close to the body in dips\n• Push-ups with a stable body line\n• Break sets before failure"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mantener el core activo en HSPU\n• Codos cerca del cuerpo en dips\n• Push-ups con línea corporal estable\n• Dividir las series antes del fallo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Manter core ativo no HSPU\n• Cotovelos próximos ao corpo nos dips\n• Push-ups com linha corporal estável\n• Quebrar séries antes da falha"
          }
        }
      }
    },
