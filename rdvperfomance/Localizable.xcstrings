    "default_workout.emCasa.costas.costas_casa.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Thoracic mobility: 8 rotations per side\n• Shoulder CARs: 6 per side\n• 2x10 Scapular push-ups (controlled)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Movilidad torácica: 8 rotaciones por lado\n• Shoulder CARs: 6 por lado\n• 2x10 Scapular push-ups (control)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mobilidade torácica: 8 rotações por lado\n• Shoulder CARs: 6 por lado\n• 2x10 Scapular push-ups (controle)"
          }
        }
      }
    },
    "default_workout.emCasa.costas.costas_casa.block.1.name" : {
