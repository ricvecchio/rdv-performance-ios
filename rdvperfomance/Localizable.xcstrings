      }
    },
    "default_workout.emCasa.core.core_casa.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Ribs down, abs firm\n• Control and range of motion without losing posture\n• Stop if you feel lower back pain"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Costillas hacia abajo, abdomen firme\n• Control y rango de movimiento sin perder la postura\n• Detente si hay dolor lumbar"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Costelas para baixo, abdômen firme\n• Controle e amplitude sem perder postura\n• Pare se houver dor lombar"
          }
        }
      }
    },
    "default_workout.emCasa.core.core_casa.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
