    "default_workout.emCasa.costas.costas_casa.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Superman hold — 3x20–40s\n2) Floor “Y-T-W” — 3x8–10 each letter\n3) Isometric towel row (foot on towel) — 4x20–30s\n4) Plank with shoulder taps — 3x20 reps\nRest: 30–60s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Superman hold — 3x20–40s\n2) “Y-T-W” en el suelo — 3x8–10 cada letra\n3) Remo isométrico con toalla (pie sobre la toalla) — 4x20–30s\n4) Plancha con toque de hombros — 3x20 reps\nDescanso: 30–60s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Superman hold — 3x20–40s\n2) “Y-T-W” no chão — 3x8–10 cada letra\n3) Remada isométrica com toalha (pé na toalha) — 4x20–30s\n4) Prancha com toque no ombro — 3x20 reps\nDescanso: 30–60s"
          }
        }
      }
    },
