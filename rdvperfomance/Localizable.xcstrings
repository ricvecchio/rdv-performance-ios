    },
    "default_workout.academia.peito.peito_b.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Control the eccentric phase (2–3s)\n• Do not flare your elbows too wide\n• Do not hyperextend your lower back on the incline bench"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Controla la fase excéntrica (2–3s)\n• No abras demasiado los codos\n• No hiperextiendas la zona lumbar en el banco inclinado"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Controle a excêntrica (2–3s)\n• Cotovelos sem “abrir demais”\n• Não hiperestender lombar no inclinado"
          }
        }
      }
    },
    "default_workout.academia.peito.peito_b.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
