    "default_workout.academia.core.core_estabilidade.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard routine to strengthen the core without excessive spinal flexion, focusing on stability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutina estándar para fortalecer el core sin un exceso de flexión de columna, centrada en la estabilidad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotina padrão para fortalecer core sem excesso de flexão de coluna, focando estabilidade."
          }
        }
      }
    },
    "default_workout.academia.core.core_estabilidade.name" : {
