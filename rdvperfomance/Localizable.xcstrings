          }
        }
      }
    },
    "default_workout.academia.fullBody.fullbody_academia.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Squat (free weight or Smith machine) — 4x6–10\n2) Bench Press (barbell/dumbbell) — 4x6–10\n3) Row (cable/dumbbell) — 4x8–12\n4) Shoulder Press (dumbbell) — 3x8–12\n5) Calf Raise — 3x12–20\n6) Core (plank) — 3x30–60s\nRest: 60–90s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Sentadilla (libre o en máquina Smith) — 4x6–10\n2) Press de Banca (barra/mancuerna) — 4x6–10\n3) Remo (cable/mancuerna) — 4x8–12\n4) Press de Hombros (mancuerna) — 3x8–12\n5) Elevación de Talones — 3x12–20\n6) Core (plancha) — 3x30–60s\nDescanso: 60–90s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Agachamento (livre ou smith) — 4x6–10\n2) Supino (barra/halter) — 4x6–10\n3) Remada (cabo/halter) — 4x8–12\n4) Desenvolvimento (halter) — 3x8–12\n5) Panturrilha — 3x12–20\n6) Core (prancha) — 3x30–60s\nDescanso: 60–90s"
          }
        }
      }
    },
