    "default_workout.crossfit.heroTributeWorkouts.rauf_2013.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High intensity. Avoid deadlift failure and run strongly but with control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta intensidad. Evitar el fallo en deadlift y mantener una carrera fuerte pero controlada."
