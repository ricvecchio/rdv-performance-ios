      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 rounds:\n• 12–20 Squats\n• 8–15 Push-ups (adapt: knees or incline)\n• 12–20 Alternating lunges (total)\n• 20–40s Plank\n• 30–60s Rest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 rondas:\n• 12–20 Sentadillas\n• 8–15 Flexiones (adaptar: rodillas o inclinadas)\n• 12–20 Zancadas alternas (total)\n• 20–40s Plancha\n• 30–60s Descanso"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 rounds:\n• 12–20 Agachamentos\n• 8–15 Flexões (adaptar: joelhos ou inclinada)\n• 12–20 Avanços alternados (total)\n• 20–40s Prancha\n• 30–60s Descanso"
          }
        }
      }
    },
