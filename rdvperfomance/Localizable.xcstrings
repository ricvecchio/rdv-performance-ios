      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust your pace to maintain technique. If needed, reduce reps and increase rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el ritmo para mantener la técnica. Si es necesario, reduce las reps y aumenta el descanso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o ritmo para manter técnica. Se necessário, diminua reps e aumente descanso."
          }
        }
      }
    },
