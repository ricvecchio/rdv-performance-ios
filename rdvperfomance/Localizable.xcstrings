        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "800 m easy run\nAnkle/hip mobility\n2 easy rounds:\n• 10 Air squats\n• 6 Light DB hang squat cleans\n• 5 Burpees"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "800 m carrera suave\nMovilidad de tobillo/cadera\n2 rondas suaves:\n• 10 Air squats\n• 6 DB hang squat cleans ligeros\n• 5 Burpees"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "800 m corrida leve\nMobilidade de tornozelo/quadril\n2 rounds leves:\n• 10 Air squats\n• 6 DB hang squat cleans leves\n• 5 Burpees"
          }
        }
      }
