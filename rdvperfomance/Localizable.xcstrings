    "default_workout.academia.costas.costas_a.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min of light cardio (bike/treadmill)\n• Thoracic mobility: 8 rotations per side\n• Activation: 2x12 Face Pull (light)\n• 1–2 light sets of cable pulldowns"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio suave (bicicleta/cinta)\n• Movilidad torácica: 8 rotaciones por lado\n• Activación: 2x12 Face Pull (ligero)\n• 1–2 series ligeras de jalón en polea"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio leve (bike/esteira)\n• Mobilidade torácica: 8 rotações por lado\n• Ativação: 2x12 Face Pull (leve)\n• 1–2 séries leves de puxada na polia"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize full range of motion and control during the eccentric phase (lowering). Short rests for accessory exercises."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioriza el rango completo de movimiento y el control en la fase excéntrica (bajada). Descansos cortos en los ejercicios accesorios."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priorize amplitude completa e controle na fase excêntrica (descida). Pausas curtas nos acessórios."
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalles"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalhes"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Shoulders “down and back” before pulling\n• Do not “cheat” with your lower back\n• Controlled eccentric phase (2–3s)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Hombros “hacia abajo y hacia atrás” antes de tirar\n• No hagas “trampas” con la zona lumbar\n• Fase excéntrica controlada (2–3s)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Ombros “para baixo e para trás” antes de puxar\n• Não “roubar” com lombar\n• Excêntrica controlada (2–3s)"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.4.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Bar Pulldown (or Pull-down) — 4x8–12\n2) Bent-Over Row (barbell/dumbbell) — 4x6–10\n3) Seated Row (cable) — 3x10–12\n4) Cable Pullover — 3x12–15\n5) Face Pull — 3x12–20\nRest: 60–90s (exercises 1–3), 45–60s (4–5)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Jalón con Barra (o Pull-down) — 4x8–12\n2) Remo Inclinado (barra/mancuerna) — 4x6–10\n3) Remo Sentado (cable) — 3x10–12\n4) Pullover en cable — 3x12–15\n5) Face Pull — 3x12–20\nDescanso: 60–90s (ejercicios 1–3), 45–60s (4–5)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Puxada na Barra (ou Pull-down) — 4x8–12\n2) Remada Curvada (barra/halter) — 4x6–10\n3) Remada Baixa (cabo) — 3x10–12\n4) Pullover no cabo — 3x12–15\n5) Face Pull — 3x12–20\nDescanso: 60–90s (exercícios 1–3), 45–60s (4–5)"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_a.block.4.name" : {
      "extractionState" : "manual",
      "localizations" : {
