    "default_workout.emCasa.pernas.pernas_casa.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 2 min of jumping jacks or running in place\n• Hip/ankle mobility: 2 min\n• 2x10 slow squats"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 2 min de saltos de tijera o carrera en el sitio\n• Movilidad de cadera/tobillo: 2 min\n• 2x10 sentadillas lentas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 2 min polichinelos ou corrida parada\n• Mobilidade de quadril/tornozelo: 2 min\n• 2x10 agachamentos lentos"
          }
        }
      }
    },
    "default_workout.emCasa.pernas.pernas_casa.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
