      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beginner: shortened run / fewer burpees\n• Scaled: step-back burpees\n• RX: As prescribed\n• Elite: maintain burpees without long breaks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Principiante: carrera reducida / menos burpees\n• Escalado: burpees con paso atrás\n• RX: Prescrito\n• Élite: mantener burpees sin descansos largos"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Iniciante: corrida reduzida / burpees reduzidos\n• Scale: burpees com step-back\n• RX: Prescrito\n• Elite: manter burpees sem pausas longas"
          }
        }
