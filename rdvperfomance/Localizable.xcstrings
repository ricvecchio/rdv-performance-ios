      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A classic strength-and-conditioning Hero WOD. Moderate-to-high-volume deadlifts combined with burpees and pull-ups demand total endurance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hero clásico de fuerza y acondicionamiento. Deadlift de volumen moderado o alto combinado con burpees y pull-ups que exige resistencia total."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hero clássico de força e condicionamento. Deadlift com volume moderado/alto combinado com burpees e pull-ups exige resistência total."
          }
        }
      }
    },
