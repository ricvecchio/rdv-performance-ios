    "default_workout.crossfit.openWods.open_13_1.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steady pacing and movement efficiency are key. Burpees that are too fast can compromise snatches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave es el ritmo constante y la eficiencia del movimiento. Los burpees demasiado rápidos pueden comprometer los snatches."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave está no ritmo constante e na economia de movimento. Burpees rápidos demais podem comprometer os snatches."
          }
        }
      }
    },
