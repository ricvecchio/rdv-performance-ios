          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.emCasa.ombros.ombros_casa.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Pike push-up (or progression) — 4x6–12\n2) Plank with movement (forward/backward) — 3x30–45s\n3) Shoulder taps — 3x20–40 reps\n4) Floor “Y-T-W” — 3x8–10 each letter\nRest: 45–75s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Pike push-up (o progresión) — 4x6–12\n2) Plancha con desplazamiento (hacia delante/atrás) — 3x30–45s\n3) Shoulder taps — 3x20–40 reps\n4) “Y-T-W” en el suelo — 3x8–10 cada letra\nDescanso: 45–75s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Pike push-up (ou progressão) — 4x6–12\n2) Prancha com deslocamento (frente/tras) — 3x30–45s\n3) Shoulder taps — 3x20–40 reps\n4) “Y-T-W” no chão — 3x8–10 cada letra\nDescanso: 45–75s"
          }
        }
      }
    },
