    "default_workout.academia.core.core_estabilidade.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Diaphragmatic breathing: 6–8 cycles\n• Cat-camel: 8 reps\n• Easy plank: 20–30s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Respiración diafragmática: 6–8 ciclos\n• Cat-camel: 8 rep\n• Plancha suave: 20–30s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Respiração diafragmática: 6–8 ciclos\n• Cat-camel: 8 rep\n• Prancha leve: 20–30s"
          }
        }
      }
    },
    "default_workout.academia.core.core_estabilidade.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.academia.core.core_estabilidade.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Ribs “down”, abs engaged\n• Neutral spine (avoid hyperextension)\n• Full control, no rushing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Costillas “hacia abajo”, abdomen activo\n• Columna neutra (evita la hiperextensión)\n• Control total, sin prisas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Costelas “para baixo”, abdômen ativo\n• Coluna neutra (evite hiperextensão)\n• Controle total, sem pressa"
          }
        }
      }
    },
    "default_workout.academia.core.core_estabilidade.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.academia.core.core_estabilidade.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Plank — 3x30–60s\n2) Dead Bug — 3x10 each side\n3) Pallof Press (cable/resistance band) — 3x12 each side\n4) Side Plank — 3x30–45s each side\n5) Farmer Carry (if a dumbbell is available) — 4x20–40m\nRest: 30–45s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Plancha — 3x30–60s\n2) Dead Bug — 3x10 cada lado\n3) Pallof Press (cable/banda elástica) — 3x12 cada lado\n4) Plancha Lateral — 3x30–45s cada lado\n5) Farmer Carry (si hay una mancuerna disponible) — 4x20–40m\nDescanso: 30–45s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Prancha — 3x30–60s\n2) Dead Bug — 3x10 cada lado\n3) Pallof Press (cabo/elástico) — 3x12 cada lado\n4) Prancha lateral — 3x30–45s cada lado\n5) Farmer Carry (se houver halter) — 4x20–40m\nDescanso: 30–45s"
          }
        }
      }
    },
    "default_workout.academia.core.core_estabilidade.block.3.name" : {
      "extractionState" : "manual",
      "localizations" : {
