        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 min easy bike\nSnatch with a light dumbbell, alternating arms\nBurpee step-over box\nShoulder and hip mobility"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 min bicicleta suave\nSnatch con mancuerna ligera alternando los brazos\nBurpee step-over box\nMovilidad de hombro y cadera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 min bike leve\nSnatch com halter leve alternado\nBurpee step-over box\nMobilidade de ombro e quadril"
          }
        }
      }
    },
