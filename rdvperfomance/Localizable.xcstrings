    "default_workout.crossfit.heroTributeWorkouts.jt_2005.block.5.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beginner: Pike push-ups / Bench dips / Incline push-ups\n• Scaled: HSPU with an AbMat / band-assisted dips\n• RX: As prescribed\n• Elite: Unbroken whenever possible"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Principiante: Pike push-ups / Bench dips / Push-ups inclinados\n• Escalado: HSPU con AbMat / dips asistidos con banda elástica\n• RX: Prescrito\n• Élite: Unbroken siempre que sea posible"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Iniciante: Pike push-ups / Bench dips / Push-ups inclinados\n• Scale: HSPU com abmat / Dips assistidos com elástico\n• RX: Prescrito\n• Elite: Unbroken sempre que possível"
          }
        }
      }
    },
