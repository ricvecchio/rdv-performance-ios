    },
    "default_workout.academia.bracos.bracos_padrao.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perform supersets (A1 + A2) to increase workout density. Focus on perfect execution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz superseries (A1 + A2) para aumentar la densidad del entrenamiento. Céntrate en una ejecución perfecta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça superséries (A1 + A2) para aumentar densidade do treino. Foque em execução perfeita."
          }
        }
      }
    },
    "default_workout.academia.bracos.bracos_padrao.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalles"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalhes"
          }
        }
      }
    },
    "default_workout.academia.bracos.bracos_padrao.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A1) Barbell Curl — 4x8–12\nA2) Cable Triceps Pushdown (straight bar) — 4x10–15\n\nB1) Alternating Curl (dumbbell) — 3x10–12\nB2) French Press (dumbbell) — 3x10–12\n\nC1) Hammer Curl — 3x10–12\nC2) Bench Dip — 3xAMRAP (good technique)\nRest: 45–60s between supersets"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A1) Curl con Barra — 4x8–12\nA2) Extensión de Tríceps en Polea (barra recta) — 4x10–15\n\nB1) Curl Alterno (mancuerna) — 3x10–12\nB2) Press Francés (mancuerna) — 3x10–12\n\nC1) Curl Martillo — 3x10–12\nC2) Fondos en Banco — 3xAMRAP (buena técnica)\nDescanso: 45–60s entre superseries"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A1) Rosca Direta (barra) — 4x8–12\nA2) Tríceps na Polia (barra reta) — 4x10–15\n\nB1) Rosca Alternada (halter) — 3x10–12\nB2) Tríceps Francês (halter) — 3x10–12\n\nC1) Rosca Martelo — 3x10–12\nC2) Mergulho no banco — 3xAMRAP (técnica boa)\nDescanso: 45–60s entre superséries"
          }
        }
      }
    },
