    "default_workout.crossfit.heroTributeWorkouts.jack_2010.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Push press with leg drive and solid lockout\n• Swing with hip-dominant movement (do not pull with the arms)\n• Jumps with a soft, controlled landing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Push press con impulso de piernas y bloqueo sólido\n• Swing con movimiento dominante de cadera (no tirar con los brazos)\n• Saltos con aterrizaje suave y control"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Push press com drive de pernas e travamento sólido\n• Swing com quadril dominante (não puxar com braços)\n• Saltos com aterrissagem suave e controle"
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.jack_2010.block.3.name" : {
