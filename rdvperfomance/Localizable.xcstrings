    "default_workout.academia.pernas.pernas_b.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Neutral spine during the hinge (RDL/deadlift)\n• Feel the hamstrings stretch, without “cheating”\n• Squeeze your glutes at the top"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Columna neutra en la bisagra de cadera (RDL/peso muerto)\n• Siente el estiramiento de los isquiotibiales, sin hacer “trampas”\n• Contrae los glúteos en la parte superior"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Coluna neutra no hinge (RDL/terra)\n• Sinta alongar posterior, sem “roubar”\n• Contraia glúteo no topo"
          }
        }
      }
    },
    "default_workout.academia.pernas.pernas_b.block.2.name" : {
