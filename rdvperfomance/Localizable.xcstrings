    "default_workout.crossfit.heroTributeWorkouts.jt_2005.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first Hero WOD published by CrossFit. A short, extremely intense workout focused on gymnastics pushing movements. Demands local muscular endurance in the shoulders and triceps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer Hero WOD publicado por CrossFit. Entrenamiento corto y extremadamente intenso centrado en movimientos gimnásticos de empuje. Exige resistencia muscular localizada en hombros y tríceps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro Hero WOD publicado pelo CrossFit. Treino curto e extremamente intenso focado em empurrar na ginástica. Exige resistência muscular localizada de ombros e tríceps."
          }
        }
      }
    },
