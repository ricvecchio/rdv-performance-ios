      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cyclic workout with running and explosive dumbbell work. High metabolic demand and heavy leg and grip involvement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento cíclico con carrera y trabajo explosivo con mancuernas. Alta exigencia metabólica y de piernas y agarre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino cíclico com corrida e trabalho explosivo com halteres. Alto desgaste metabólico e demanda de pernas/grip."
          }
        }
      }
    },
