    "default_workout.emCasa.costas.costas_casa.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a resistance band, you can add pulldowns. Without a band, focus on control and isometric holds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes una banda elástica, puedes añadir jalones. Sin banda elástica, céntrate en el control y la isometría."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tiver elástico, pode adicionar puxadas. Sem elástico, foque em controle e isometria."
          }
        }
      }
    },
    "default_workout.emCasa.costas.costas_casa.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
