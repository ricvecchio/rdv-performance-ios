    "default_workout.academia.fullBody.fullbody_academia.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete workout with basic exercises for those who need a well-balanced general routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento completo con ejercicios básicos para quien necesita una rutina general bien equilibrada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino completo com básicos para quem precisa de um treino geral bem equilibrado."
          }
        }
      }
    },
