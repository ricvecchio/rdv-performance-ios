    "default_workout.crossfit.heroTributeWorkouts.horton_2015.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partner workout: only one person works at a time. Split the work into short blocks to keep intensity high."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento en pareja: solo trabaja una persona a la vez. Dividir el trabajo en bloques cortos para mantener la intensidad alta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
