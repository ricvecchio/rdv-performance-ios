    "default_workout.crossfit.heroTributeWorkouts.schmidt_2014.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique with an empty bar:\n• 5 Deadlifts\n• 5 Hang power cleans\n• 5 Push jerks\nShoulder/hip mobility"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica con barra vacía:\n• 5 Deadlifts\n• 5 Hang power cleans\n• 5 Push jerks\nMovilidad de hombros/cadera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica com barra vazia:\n• 5 Deadlifts\n• 5 Hang power cleans\n• 5 Push jerks\nMobilidade de ombros/quadril"
          }
        }
      }
    },
