    "default_workout.academia.peito.peito_a.block.4.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Flat Bench Press (barbell) — 5x5–8\n2) Incline Bench Press (dumbbell) — 4x8–12\n3) Chest Fly (machine/dumbbell) — 3x10–15\n4) Parallel Bar Dips (or assisted dips) — 3x6–12\n5) Cable Triceps Pushdown — 3x10–15\nRest: 90s (1), 60–90s (2), 45–60s (3–5)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Press de Banca Plano (barra) — 5x5–8\n2) Press de Banca Inclinado (mancuerna) — 4x8–12\n3) Aperturas de Pecho (máquina/mancuerna) — 3x10–15\n4) Fondos en Paralelas (o fondos asistidos) — 3x6–12\n5) Extensión de Tríceps en Polea — 3x10–15\nDescanso: 90s (1), 60–90s (2), 45–60s (3–5)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Supino Reto (barra) — 5x5–8\n2) Supino Inclinado (halter) — 4x8–12\n3) Crucifixo (máquina/halter) — 3x10–15\n4) Paralelas (ou mergulho assistido) — 3x6–12\n5) Tríceps na polia — 3x10–15\nDescanso: 90s (1), 60–90s (2), 45–60s (3–5)"
          }
        }
      }
    },
