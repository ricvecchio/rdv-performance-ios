    "default_workout.crossfit.heroTributeWorkouts.roy_2013.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hip/lower-back mobility\nTechnique for deadlift with an empty bar\n2 easy rounds:\n• 6 Light Deadlifts\n• 6 Burpees\n• 5 Ring rows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad de cadera/zona lumbar\nTécnica de deadlift con barra vacía\n2 rondas suaves:\n• 6 Deadlifts ligeros\n• 6 Burpees\n• 5 Ring rows"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade de quadril/lombar\nTécnica de deadlift com barra vazia\n2 rounds leves:\n• 6 Deadlifts leves\n• 6 Burpees\n• 5 Ring rows"
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.roy_2013.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
