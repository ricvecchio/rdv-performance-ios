        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beginner: light load / reduced repetitions\n• Scaled: 155/105 lb / band-assisted pull-ups\n• RX: As prescribed\n• Elite: consistent rounds with few breaks"
          }
        },
        "es" : {
          "stringUnit" : {
