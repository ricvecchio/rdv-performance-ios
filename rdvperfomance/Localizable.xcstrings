    "default_workout.crossfit.heroTributeWorkouts.gale_force_2022.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High volume per round. Maintain a sustainable pace and break pull-ups and burpees into sets early."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento de alto volumen por ronda. Mantener un ritmo sostenible y dividir los pull-ups y burpees pronto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino com volume alto por round. Estratégia é manter ritmo sustentável e quebrar pull-ups/burpees cedo."
          }
        }
      }
    },
