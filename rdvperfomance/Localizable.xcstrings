    "default_workout.crossfit.heroTributeWorkouts.wright_2017.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General mobility\nTechnique for power clean with a light bar\n2 easy rounds:\n• 5 Light Power cleans\n• 8 Push-ups\n• 10 Squats"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad general\nTécnica de power clean con barra ligera\n2 rondas suaves:\n• 5 Power cleans ligeros\n• 8 Push-ups\n• 10 Squats"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade geral\nTécnica de power clean com barra leve\n2 rounds leves:\n• 5 Power cleans leves\n• 8 Push-ups\n• 10 Squats"
          }
        }
      }
