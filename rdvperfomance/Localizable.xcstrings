    "default_workout.crossfit.heroTributeWorkouts.saman_2013.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "800 m easy run\nHip and shoulder mobility\n2 easy rounds:\n• 6 Light Deadlifts\n• 10 Light Wall-ball shots"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "800 m carrera suave\nMovilidad de cadera y hombros\n2 rondas suaves:\n• 6 Deadlifts ligeros\n• 10 Wall-ball shots ligeros"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "800 m corrida leve\nMobilidade quadril e ombros\n2 rounds leves:\n• 6 Deadlifts leves\n• 10 Wall-ball shots leves"
          }
        }
      }
    },
