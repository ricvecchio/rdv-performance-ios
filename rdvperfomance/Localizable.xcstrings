    "default_workout.crossfit.heroTributeWorkouts.randy_2008.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short, explosive Hero WOD focused on snatches. Demands consistent technique under increasing metabolic fatigue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hero WOD corto y explosivo centrado en el snatch. Exige técnica constante bajo fatiga metabólica creciente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hero WOD curto e explosivo focado em snatch. Exige técnica consistente sob fadiga metabólica crescente."
          }
        }
      }
    },
