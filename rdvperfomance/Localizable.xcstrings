    "default_workout.academia.peito.peito_b.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Incline Bench Press (barbell/dumbbell) — 4x8–12\n2) Flat Bench Press (dumbbell) — 4x10–12\n3) Peck-deck — 3x12–15\n4) Cable Crossover — 3x12–20\n5) Push-ups to near failure — 2 sets\nRest: 45–75s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Press de Banca Inclinado (barra/mancuerna) — 4x8–12\n2) Press de Banca Plano (mancuerna) — 4x10–12\n3) Peck-deck — 3x12–15\n4) Crossover en cable — 3x12–20\n5) Flexiones hasta cerca del fallo — 2 series\nDescanso: 45–75s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Supino Inclinado (barra/halter) — 4x8–12\n2) Supino Reto (halter) — 4x10–12\n3) Peck-deck — 3x12–15\n4) Crossover no cabo — 3x12–20\n5) Flexão até perto da falha — 2 séries\nDescanso: 45–75s"
          }
        }
      }
    },
