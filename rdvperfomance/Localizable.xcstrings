    "default_workout.academia.pernas.pernas_b.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Romanian Deadlift — 4x6–10\n2) Lying Leg Curl — 4x10–12\n3) Hip Thrust — 4x8–12\n4) Bulgarian Split Squat — 3x8–10 each leg\n5) Seated Calf Raise — 4x12–20\nRest: 60–90s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Peso Muerto Rumano — 4x6–10\n2) Curl Femoral Tumbado — 4x10–12\n3) Hip Thrust — 4x8–12\n4) Sentadilla Búlgara — 3x8–10 cada pierna\n5) Elevación de Talones Sentado — 4x12–20\nDescanso: 60–90s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Levantamento Terra Romeno — 4x6–10\n2) Mesa Flexora — 4x10–12\n3) Hip Thrust — 4x8–12\n4) Afundo (búlgaro) — 3x8–10 cada perna\n5) Panturrilha sentado — 4x12–20\nDescanso: 60–90s"
          }
        }
      }
    },
