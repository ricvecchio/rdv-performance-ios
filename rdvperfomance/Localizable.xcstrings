      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A brutal endurance workout with high-volume burpees between two long runs. A major mental and aerobic challenge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento brutal de resistencia con gran volumen de burpees entre dos carreras largas. Gran desafío mental y aeróbico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino brutal de resistência com grande volume de burpees entre duas corridas longas. Forte desafio mental e aeróbico."
          }
