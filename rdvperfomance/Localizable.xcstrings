    "default_workout.crossfit.openWods.open_13_5.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Fluid thruster with synchronized breathing\n• Pull-ups unbroken when possible\n• Quick transitions between movements"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Thruster fluido con respiración sincronizada\n• Pull-ups sin interrupción cuando sea posible\n• Transiciones rápidas entre movimientos"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Thruster fluido com respiração sincronizada\n• Pull-ups unbroken quando possível\n• Transições rápidas entre movimentos"
          }
        }
      }
    },
    "default_workout.crossfit.openWods.open_13_5.block.3.name" : {
