      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The limiting factor is muscle-up consistency under fatigue. Controlling squat pace preserves technique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El factor limitante es la constancia en muscle-ups bajo fatiga. Controlar el ritmo de sentadillas preserva la técnica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fator limitante é a consistência nos muscle-ups sob fadiga. Controlar o ritmo dos squats preserva a técnica."
          }
        }
