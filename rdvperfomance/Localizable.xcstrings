    "default_workout.crossfit.heroTributeWorkouts.gale_force_2022.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 min easy rowing\nHip/ankle mobility\nTechnique for front squat with a light load\n2 easy rounds:\n• 5 Light Front squats\n• 5 Pull-ups (assisted)\n• 5 Burpees"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 min remo suave\nMovilidad de cadera/tobillo\nTécnica de front squat con carga ligera\n2 rondas suaves:\n• 5 Front squats ligeros\n• 5 Pull-ups (asistido)\n• 5 Burpees"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 min remo leve\nMobilidade de quadril/tornozelo\nTécnica de front squat com carga leve\n2 rounds leves:\n• 5 Front squats leves\n• 5 Pull-ups (assistido)\n• 5 Burpees"
          }
        }
      }
    },
