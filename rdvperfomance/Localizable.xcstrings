      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You do not have permission to access this student’s messages. Confirm that you are signed in as a TRAINER and that Firestore rules allow /users/{alunoId}/messages."
