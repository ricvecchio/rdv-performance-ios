    "default_workout.academia.fullBody.fullbody_academia.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min of light cardio\n• Mobility: hip/ankle/shoulder (3–5 min)\n• 1 light set of each main exercise"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min de cardio suave\n• Movilidad: cadera/tobillo/hombro (3–5 min)\n• 1 serie ligera de cada ejercicio principal"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min cardio leve\n• Mobilidade: quadril/tornozelo/ombro (3–5 min)\n• 1 série leve de cada exercício principal"
          }
        }
      }
    },
    "default_workout.academia.fullBody.fullbody_academia.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
