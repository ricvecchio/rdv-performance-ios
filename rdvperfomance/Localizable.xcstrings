    "default_workout.academia.peito.peito_a.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min of light cardio\n• Shoulder/chest mobility (doorway): 30s per side\n• 2x12 light External Rotations (resistance band)\n• 2 progressive bench press sets (light)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio suave\n• Movilidad de hombros/pectoral (marco de puerta): 30s por lado\n• 2x12 Rotación Externa (banda elástica) ligera\n• 2 series progresivas de press de banca (ligero)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min cardio leve\n• Mobilidade de ombros/peitoral (porta): 30s por lado\n• 2x12 Rotação externa (elástico) leve\n• 2 séries progressivas de supino (leve)"
          }
        }
      }
    },
    "default_workout.academia.peito.peito_a.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.academia.peito.peito_a.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your shoulder blades stable and avoid losing posture during the bench press. Increase the load only with perfect technique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén las escápulas estabilizadas y evita perder la postura en el press de banca. Aumenta la carga solo con una técnica perfecta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha escápulas estabilizadas e evite perder postura no supino. Aumente carga só com técnica perfeita."
          }
        }
      }
    },
    "default_workout.academia.peito.peito_a.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalles"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalhes"
          }
        }
      }
    },
    "default_workout.academia.peito.peito_a.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Shoulder blades “set” on the bench\n• Feet firmly on the floor\n• Lower the bar with control to chest level"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Escápulas “encajadas” en el banco\n• Pies firmes en el suelo\n• La barra baja de forma controlada hasta la línea del pecho"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Escápulas “encaixadas” no banco\n• Pés firmes no chão\n• Barra desce controlada até a linha do peito"
          }
        }
      }
    },
