        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beginner: shortened run / light load\n• Scaled: 95/65 lb\n• RX: As prescribed\n• Elite: quick transitions and deadlift in long sets"
          }
        },
        "es" : {
          "stringUnit" : {
