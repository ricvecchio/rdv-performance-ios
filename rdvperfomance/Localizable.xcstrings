    "default_workout.crossfit.heroTributeWorkouts.jt_2005.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 easy rounds:\n• 10 Push-ups\n• 10 Ring rows\n• 10 Air squats\nShoulder and wrist mobility\n2 technique sets of handstand hold (20s)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 rondas suaves:\n• 10 Push-ups\n• 10 Ring rows\n• 10 Air squats\nMovilidad de hombros y muñecas\n2 series técnicas de handstand hold (20s)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 rounds leves:\n• 10 Push-ups\n• 10 Ring rows\n• 10 Air squats\nMobilidade de ombros e punhos\n2 séries técnicas de handstand hold (20s)"
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.jt_2005.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
