    "default_workout.crossfit.heroTributeWorkouts.randy_2008.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Bar close to the body\n• Stable overhead catch\n• Full hip extension\n• Avoid pulling only with the arms"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Barra cerca del cuerpo\n• Recepción estable sobre la cabeza\n• Extensión completa de cadera\n• Evitar tirar solo con los brazos"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Barra próxima ao corpo\n• Recepção estável acima da cabeça\n• Extensão completa do quadril\n• Evitar puxar apenas com braços"
          }
        }
      }
    },
