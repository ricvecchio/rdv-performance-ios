    "default_workout.crossfit.heroTributeWorkouts.rankel_2013.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique with a light bar\nShoulder and hip mobility\n2 easy rounds:\n• 6 Light Deadlifts\n• 5 Burpee pull-ups (or burpees + ring rows)\n• 8 Light KB swings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica con barra ligera\nMovilidad de hombros y cadera\n2 rondas suaves:\n• 6 Deadlifts ligeros\n• 5 Burpee pull-ups (o burpees + ring rows)\n• 8 KB swings ligeros"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica com barra leve\nMobilidade ombros e quadril\n2 rounds leves:\n• 6 Deadlifts leves\n• 5 Burpee pull-ups (ou burpees + ring rows)\n• 8 KB swings leves"
          }
        }
      }
    },
