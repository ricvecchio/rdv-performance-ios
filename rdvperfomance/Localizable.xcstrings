    "default_workout.crossfit.heroTributeWorkouts.hamilton_2013.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Controlled breathing during cardio\n• Pull-ups with short, consistent repetition sets\n• Avoid an opening sprint that leaves you exhausted halfway through"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Respiración controlada durante el cardio\n• Pull-ups con series cortas y constantes de repeticiones\n• Evitar un sprint inicial que agote a mitad del entrenamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Respiração controlada durante o cardio\n• Pull-ups com reps curtas e consistentes\n• Evitar sprint inicial que “apaga” no meio"
          }
        }
      }
    },
