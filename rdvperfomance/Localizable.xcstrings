          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.roy_2013.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not exhaust grip on deadlifts and keep burpees steady. Short pull-up sets help significantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No agotar el agarre en deadlift y mantener los burpees constantes. Las series cortas de pull-ups ayudan mucho."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave é não queimar o grip no deadlift e manter burpees constantes. Pull-ups em séries curtas ajudam muito."
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.roy_2013.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
