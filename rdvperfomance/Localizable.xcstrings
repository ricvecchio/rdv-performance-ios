    "default_workout.academia.ombros.ombros_padrao.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard workout for the anterior/lateral/posterior deltoids, promoting shoulder stability and health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento estándar para los deltoides anterior/lateral/posterior, con estabilidad y salud del hombro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino padrão para deltoide anterior/lateral/posterior com estabilidade e saúde do ombro."
          }
        }
      }
    },
