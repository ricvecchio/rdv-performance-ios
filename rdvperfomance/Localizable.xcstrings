    "default_workout.crossfit.heroTributeWorkouts.randy_2008.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fast workout. The bar must stay light enough for continuous cycling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento rápido. La barra debe ser lo bastante ligera para mantener un ciclo continuo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino rápido. A barra deve permanecer leve o suficiente para manter ciclo contínuo."
          }
        }
      }
    },
