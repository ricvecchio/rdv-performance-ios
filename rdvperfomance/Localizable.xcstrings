    "default_workout.academia.costas.costas_b.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min of light cardio\n• 2x10 Scapular Pull-ups (or on the cable machine)\n• 2x12 light Single-Arm Rows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio suave\n• 2x10 Scapular Pull-ups (o en polea)\n• 2x12 Remo Unilateral ligero"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio leve\n• 2x10 Scapular Pull-ups (ou na polia)\n• 2x12 Remada unilateral leve"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_b.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_b.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Keep your torso firm and abs engaged\n• Keep elbows close to your body during rows\n• Avoid shrugging your shoulders at the top"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Tronco firme y abdomen activo\n• Codos cerca del cuerpo en los remos\n• Evita encoger los hombros en la parte superior"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Tronco firme e abdômen ativo\n• Cotovelos próximos ao corpo nas remadas\n• Evite encolher ombros no topo"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_b.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_b.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) T-Bar Row — 5x5–8\n2) Pull-up (or Pull-down) — 4x6–10\n3) Single-Arm Row (dumbbell) — 3x8–12 each side\n4) Shrug (dumbbell/barbell) — 3x10–15\n5) Back Extension (machine/bench) — 3x12–15 (controlled)\nRest: 90s (1), 60–90s (2–3), 45–60s (4–5)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Remo en T (T-Bar) — 5x5–8\n2) Dominadas (o Pull-down) — 4x6–10\n3) Remo Unilateral (mancuerna) — 3x8–12 cada lado\n4) Encogimiento de Hombros (mancuerna/barra) — 3x10–15\n5) Extensión Lumbar (máquina/banco) — 3x12–15 (control)\nDescanso: 90s (1), 60–90s (2–3), 45–60s (4–5)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Remada Cavalinho (T-Bar) — 5x5–8\n2) Barra Fixa (ou Pull-down) — 4x6–10\n3) Remada Unilateral (halter) — 3x8–12 cada lado\n4) Encolhimento (halter/barra) — 3x10–15\n5) Extensão Lombar (máquina/banco) — 3x12–15 (controle)\nDescanso: 90s (1), 60–90s (2–3), 45–60s (4–5)"
          }
        }
      }
    },
    "default_workout.academia.costas.costas_b.block.3.name" : {
      "extractionState" : "manual",
      "localizations" : {
