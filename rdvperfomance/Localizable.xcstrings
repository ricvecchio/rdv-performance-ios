    "default_workout.academia.peito.peito_b.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min of light cardio\n• 2x15 Push-ups (adapt if needed)\n• 1–2 light sets on the peck-deck machine"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio suave\n• 2x15 Push-ups (adaptar si es necesario)\n• 1–2 series ligeras en la máquina peck-deck"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5 min de cardio leve\n• 2x15 Push-ups (adaptar se necessário)\n• 1–2 séries leves de máquina peck-deck"
          }
        }
      }
    },
    "default_workout.academia.peito.peito_b.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
