    "default_workout.academia.pernas.pernas_a.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min on the bike\n• Mobility: ankle (8–10 reps), hip (8 reps)\n• 2x12 Bodyweight Squats\n• 2 progressive sets of the main exercise"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min de bicicleta\n• Movilidad: tobillo (8–10 rep), cadera (8 rep)\n• 2x12 Sentadillas con peso corporal\n• 2 series progresivas del ejercicio principal"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 5–8 min bike\n• Mobilidade: tornozelo (8–10 rep), quadril (8 rep)\n• 2x12 Agachamento com peso corporal\n• 2 séries progressivas do exercício principal"
          }
        }
      }
    },
    "default_workout.academia.pernas.pernas_a.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.academia.pernas.pernas_a.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Knee follows the line of the foot\n• Keep your torso firm and abs engaged\n• Lower with control, rise with power"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• La rodilla sigue la línea del pie\n• Tronco firme y abdomen activo\n• Bajada controlada, sube con potencia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Joelho acompanha a linha do pé\n• Tronco firme e abdômen ativo\n• Descida controlada, suba com potência"
          }
        }
      }
    },
    "default_workout.academia.pernas.pernas_a.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.academia.pernas.pernas_a.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Barbell Squat — 5x5–8\n2) Leg Press — 4x10–12\n3) Leg Extension — 3x12–15\n4) Walking Lunge (dumbbell) — 3x10 each leg\n5) Standing Calf Raise — 4x12–20\nRest: 90s (1), 60–90s (2), 45–60s (3–5)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Sentadilla con Barra Libre — 5x5–8\n2) Prensa de Piernas — 4x10–12\n3) Extensión de Cuádriceps — 3x12–15\n4) Zancada Caminando (mancuerna) — 3x10 cada pierna\n5) Elevación de Talones de Pie — 4x12–20\nDescanso: 90s (1), 60–90s (2), 45–60s (3–5)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Agachamento Livre — 5x5–8\n2) Leg Press — 4x10–12\n3) Cadeira Extensora — 3x12–15\n4) Passada (halter) — 3x10 cada perna\n5) Panturrilha em pé — 4x12–20\nDescanso: 90s (1), 60–90s (2), 45–60s (3–5)"
          }
        }
      }
    },
