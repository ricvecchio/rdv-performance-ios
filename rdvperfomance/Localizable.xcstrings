    "default_workout.emCasa.pernas.pernas_casa.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Squat (tempo 3-1-1) — 4x12–20\n2) Alternating lunge — 3x10–16 each leg\n3) Glute bridge — 4x12–20 (1s pause at the top)\n4) Good morning with no load — 3x15–20\n5) Calf raise on a step — 4x15–25\nRest: 30–60s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Sentadilla (tempo 3-1-1) — 4x12–20\n2) Zancada alterna (lunge) — 3x10–16 cada pierna\n3) Puente de glúteos — 4x12–20 (pausa de 1s arriba)\n4) Good morning sin carga — 3x15–20\n5) Elevación de talones en un escalón — 4x15–25\nDescanso: 30–60s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Agachamento (tempo 3-1-1) — 4x12–20\n2) Avanço alternado (lunge) — 3x10–16 cada perna\n3) Ponte de glúteos — 4x12–20 (pausa 1s no topo)\n4) Good morning sem carga — 3x15–20\n5) Panturrilha no degrau — 4x15–25\nDescanso: 30–60s"
          }
        }
      }
    },
