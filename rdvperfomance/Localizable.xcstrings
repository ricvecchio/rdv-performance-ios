    "default_workout.academia.bracos.bracos_padrao.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 3–5 min of light cardio\n• 2x15 Barbell Curls (very light)\n• 2x15 Cable Triceps Pushdowns (very light)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 3–5 min de cardio suave\n• 2x15 Curl con Barra (muy ligero)\n• 2x15 Extensión de Tríceps en Polea (muy ligera)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 3–5 min de cardio leve\n• 2x15 Rosca direta (muito leve)\n• 2x15 Tríceps polia (muito leve)"
          }
        }
      }
    },
    "default_workout.academia.bracos.bracos_padrao.block.1.name" : {
