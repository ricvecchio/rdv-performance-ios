    "default_workout.crossfit.heroTributeWorkouts.taylor_2015.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy running\nShoulder and wrist mobility\nEasy practice:\n• 2-3 well-controlled sets of HSPU (or pike push-ups)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrera suave\nMovilidad de hombros y muñecas\nPráctica suave:\n• 2-3 series bien controladas de HSPU (o pike push-ups)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrida leve\nMobilidade de ombros e punhos\nPrática leve:\n• 2-3 séries de HSPU (ou pike) bem controladas"
          }
        }
      }
    },
