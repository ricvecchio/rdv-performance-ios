    "default_workout.crossfit.heroTributeWorkouts.horton_2015.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder/hip mobility\nLight clean and jerk technique work\n2 easy rounds:\n• 5 bar dips (or a box dip)\n• 5 Light power cleans\n• 20 m easy buddy carry (or sandbag carry)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad de hombros/cadera\nTécnica ligera de clean and jerk\n2 rondas suaves:\n• 5 bar dips (o dip en cajón)\n• 5 power cleans ligeros\n• 20 m de buddy carry suave (o sandbag carry)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade de ombros/quadril\nTécnica leve de clean and jerk\n2 rounds leves:\n• 5 bar dips (ou dip em caixa)\n• 5 power cleans leves\n• 20 m buddy carry leve (ou sandbag carry)"
          }
        }
      }
    },
