    "default_workout.crossfit.heroTributeWorkouts.kalsu_2011.block.5.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beginner: light load / fewer burpees\n• Scaled: 95/65 lb\n• RX: As prescribed\n• Elite: thrusters in long sets, burpees without a break"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Principiante: carga ligera / menos burpees\n• Escalado: 95/65 lb\n• RX: Prescrito\n• Élite: thrusters en series largas, burpees sin descanso"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Iniciante: carga leve / burpees reduzidos\n• Scale: 95/65 lb\n• RX: Prescrito\n• Elite: thrusters em séries longas, burpees sem pausa"
          }
        }
      }
    },
