      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP in 3 min blocks:\n• 2 Overhead Squats (43kg)\n• 2 Chest-to-Bar Pull-ups\n\nEvery 3 min block:\n• Add 2 repetitions of each movement\nContinue while completing the block within the time limit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP en bloques de 3 min:\n• 2 Overhead Squats (43kg)\n• 2 Chest-to-Bar Pull-ups\n\nEn cada bloque de 3 min:\n• Aumentar 2 repeticiones de cada movimiento\nContinuar mientras se complete el bloque dentro del tiempo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP em blocos de 3 min:\n• 2 Overhead Squats (43kg)\n• 2 Chest-to-Bar Pull-ups\n\nA cada bloco de 3 min:\n• aumentar 2 reps de cada movimento\nContinuar enquanto completar o bloco dentro do tempo"
          }
        }
      }
