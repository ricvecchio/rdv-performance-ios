    "default_workout.emCasa.core.core_casa.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Diaphragmatic breathing: 6 cycles\n• Cat-camel: 8 reps\n• Easy dead bug: 6 each side"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Respiración diafragmática: 6 ciclos\n• Cat-camel: 8 rep\n• Dead bug suave: 6 cada lado"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Respiração diafragmática: 6 ciclos\n• Cat-camel: 8 rep\n• Dead bug leve: 6 cada lado"
          }
        }
      }
    },
    "default_workout.emCasa.core.core_casa.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
