    "default_workout.crossfit.openWods.open_17_3.block.4.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time cap 24 min:\n• 6 Chest-to-Bar Pull-ups\n• 6 Squat Snatches (43kg)\n• 7 Chest-to-Bar\n• 5 Squat Snatches (52kg)\n• 8 Chest-to-Bar\n• 4 Squat Snatches (61kg)\n• 9 Chest-to-Bar\n• 3 Squat Snatches (70kg)\n• 10 Chest-to-Bar\n• 2 Squat Snatches (79kg)\n• 11 Chest-to-Bar\n• 1 Squat Snatch (88kg)\nContinue the progression with bar muscle-ups and heavier loads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de tiempo de 24 min:\n• 6 Chest-to-Bar Pull-ups\n• 6 Squat Snatches (43kg)\n• 7 Chest-to-Bar\n• 5 Squat Snatches (52kg)\n• 8 Chest-to-Bar\n• 4 Squat Snatches (61kg)\n• 9 Chest-to-Bar\n• 3 Squat Snatches (70kg)\n• 10 Chest-to-Bar\n• 2 Squat Snatches (79kg)\n• 11 Chest-to-Bar\n• 1 Squat Snatch (88kg)\nContinuar la progresión con bar muscle-ups y cargas mayores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time cap 24 min:\n• 6 Chest-to-Bar Pull-ups\n• 6 Squat Snatches (43kg)\n• 7 Chest-to-Bar\n• 5 Squat Snatches (52kg)\n• 8 Chest-to-Bar\n• 4 Squat Snatches (61kg)\n• 9 Chest-to-Bar\n• 3 Squat Snatches (70kg)\n• 10 Chest-to-Bar\n• 2 Squat Snatches (79kg)\n• 11 Chest-to-Bar\n• 1 Squat Snatch (88kg)\nContinuar progressão com bar muscle-ups e cargas maiores."
          }
        }
      }
    },
