    "default_workout.crossfit.heroTributeWorkouts.oda_7313_2023.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General mobility\n2 easy rounds of the movements:\n• 30 single unders (jump rope)\n• 8 Light Wall-ball shots\n• 6 Light Deadlifts\n• 5 Pull-ups (assisted)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad general\n2 rondas suaves de los movimientos:\n• 30 saltos simples (cuerda)\n• 8 Wall-ball shots ligeros\n• 6 Deadlifts ligeros\n• 5 Pull-ups (asistido)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade geral\n2 rounds leves dos movimentos:\n• 30 singles (corda)\n• 8 Wall-ball shots leves\n• 6 Deadlifts leves\n• 5 Pull-ups (assistido)"
          }
        }
      }
    },
