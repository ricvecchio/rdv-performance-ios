            "state" : "translated",
            "value" : "Consistent rounds are key. Avoid sprinting to preserve efficiency in the following movements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener rondas constantes es la clave. Evitar esprintar para preservar la eficiencia en los movimientos siguientes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter rounds consistentes é a chave. Evite sprintar para não perder eficiência nos movimentos seguintes."
          }
        }
      }
    },
