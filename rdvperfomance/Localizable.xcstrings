    "default_workout.crossfit.openWods.open_13_5.block.4.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For time (initial 4 min cap):\n• 15 Thrusters (43kg)\n• 15 Chest-to-Bar Pull-ups\n\nIf completed within the cap:\n• Add 3 more min and repeat the cycle, increasing repetitions to 18/18, then 21/21, etc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por tiempo (límite inicial de 4 min):\n• 15 Thrusters (43kg)\n• 15 Chest-to-Bar Pull-ups\n\nSi se completa dentro del límite:\n• Añadir 3 min más y repetir el ciclo aumentando las repeticiones a 18/18, después 21/21, etc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For time (4 min cap inicial):\n• 15 Thrusters (43kg)\n• 15 Chest-to-Bar Pull-ups\n\nSe completado dentro do cap:\n• adiciona-se mais 3 min e repete o ciclo aumentando reps para 18/18, depois 21/21, etc."
          }
        }
      }
    },
