      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Thruster with a fluid transition (front squat → press)\n• Burpees with rhythmic breathing\n• Break thrusters into sets before failure"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Thruster con transición fluida (front squat → press)\n• Burpees con respiración rítmica\n• Dividir los thrusters antes del fallo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
