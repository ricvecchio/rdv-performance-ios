    "default_workout.academia.costas.costas_b.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on heavy rows and recruitment of the middle/lower trapezius for density."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfoque en remos pesados y activación del trapecio medio/inferior para aumentar la densidad muscular."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco em remadas pesadas e recrutamento de trapézio médio/inferior para densidade."
          }
        }
      }
    },
