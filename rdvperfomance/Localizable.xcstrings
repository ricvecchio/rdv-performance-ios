    "default_workout.emCasa.core.core_casa.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Dead Bug — 3x10 each side\n2) Hollow hold (or tuck) — 4x20–40s\n3) Side plank — 3x30–45s each side\n4) Mountain climbers (controlled) — 3x30–45s\nRest: 30–45s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Dead Bug — 3x10 cada lado\n2) Hollow hold (o tuck) — 4x20–40s\n3) Plancha lateral — 3x30–45s cada lado\n4) Mountain climbers (controlados) — 3x30–45s\nDescanso: 30–45s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Dead Bug — 3x10 cada lado\n2) Hollow hold (ou tuck) — 4x20–40s\n3) Prancha lateral — 3x30–45s cada lado\n4) Mountain climbers (controlado) — 3x30–45s\nDescanso: 30–45s"
          }
        }
      }
    },
