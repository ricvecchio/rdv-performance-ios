            "state" : "translated",
            "value" : "Por tiempo:\n7 rondas:\n• 7 Handstand push-ups\n• 7 Thrusters (135/95 lb)\n• 7 Knees-to-elbows\n• 7 Deadlifts (245/165 lb)\n• 7 Burpees\n• 7 Kettlebell swings\n• 7 Pull-ups"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For time:\n7 rounds:\n• 7 Handstand push-ups\n• 7 Thrusters (135/95 lb)\n• 7 Knees-to-elbows\n• 7 Deadlifts (245/165 lb)\n• 7 Burpees\n• 7 Kettlebell swings\n• 7 Pull-ups"
          }
        }
