    "default_workout.emCasa.fullBody.fullbody_casa.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 2–3 min of jumping jacks or running in place\n• General mobility: 2 min\n• 10 squats + 10 incline push-ups"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 2–3 min de saltos de tijera o carrera en el sitio\n• Movilidad general: 2 min\n• 10 sentadillas + 10 push-ups inclinadas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 2–3 min polichinelos ou corrida parada\n• Mobilidade geral: 2 min\n• 10 agachamentos + 10 push-ups inclinadas"
          }
        }
      }
    },
