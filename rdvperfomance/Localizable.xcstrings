    "default_workout.emCasa.bracos.bracos_casa.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Close-grip push-up — 4x8–15\n2) Triceps dips on a bench/chair — 4x10–20\n3) Isometric biceps hold with a towel (pull against the foot) — 4x20–30s\n4) Plank — 3x30–60s\nRest: 30–60s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Flexión con agarre cerrado — 4x8–15\n2) Fondos de tríceps en banco/silla — 4x10–20\n3) Isometría de bíceps con toalla (tirar contra el pie) — 4x20–30s\n4) Plancha — 3x30–60s\nDescanso: 30–60s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Flexão fechada — 4x8–15\n2) Tríceps no banco/cadeira — 4x10–20\n3) Isometria de bíceps com toalha (puxar contra o pé) — 4x20–30s\n4) Prancha — 3x30–60s\nDescanso: 30–60s"
          }
        }
      }
    },
