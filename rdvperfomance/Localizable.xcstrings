    "default_workout.emCasa.ombros.ombros_casa.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Gentle shoulder taps: 2x10\n• Shoulder mobility: 1–2 min\n• 2x20s plank"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Shoulder taps suaves: 2x10\n• Movilidad de hombros: 1–2 min\n• 2x20s de plancha"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Shoulder taps leves: 2x10\n• Mobilidade de ombros: 1–2 min\n• 2x20s prancha"
          }
        }
      }
    },
    "default_workout.emCasa.ombros.ombros_casa.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.emCasa.ombros.ombros_casa.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Avoid “sinking” into the plank\n• Control your breathing\n• Shoulders away from your ears"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Evita “hundirte” en la plancha\n• Controla la respiración\n• Hombros lejos de las orejas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Evite “afundar” na prancha\n• Controle a respiração\n• Ombros longe das orelhas"
          }
        }
      }
    },
    "default_workout.emCasa.ombros.ombros_casa.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
