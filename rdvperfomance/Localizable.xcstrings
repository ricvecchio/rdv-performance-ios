      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Beginner: Light push press / light KB / step-ups\n• Scaled: reduce the load and box height\n• RX: As prescribed\n• Elite: consistent rounds with immediate transitions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Principiante: push press ligero / KB ligera / step-ups\n• Escalado: reducir la carga y altura del cajón\n• RX: Prescrito\n• Élite: rondas constantes con transiciones inmediatas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Iniciante: push press leve / KB leve / step-ups\n• Scale: reduzir carga e altura da caixa\n• RX: Prescrito\n• Elite: rounds consistentes com transições imediatas"
          }
        }
