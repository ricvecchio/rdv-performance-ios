    "default_workout.crossfit.heroTributeWorkouts.kalsu_2011.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start every minute with burpees, then accumulate thrusters. Avoid thruster failure and keep burpees fast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenzar cada minuto con burpees y después acumular thrusters. Evitar el fallo en thruster y mantener los burpees rápidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada minuto inicia com burpees e depois acumula thrusters. A estratégia é não falhar no thruster e manter burpees rápidos."
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.kalsu_2011.block.2.name" : {
