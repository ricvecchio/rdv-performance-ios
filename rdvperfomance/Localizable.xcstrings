    "default_workout.crossfit.heroTributeWorkouts.kalsu_2011.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder and hip mobility\nTechnique for thruster with an empty bar\n2 easy rounds:\n• 5 Burpees\n• 5 Light Thrusters"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movilidad de hombros y cadera\nTécnica de thruster con barra vacía\n2 rondas suaves:\n• 5 Burpees\n• 5 Thrusters ligeros"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilidade ombros e quadril\nTécnica de thruster com barra vazia\n2 rounds leves:\n• 5 Burpees\n• 5 Thrusters leves"
          }
        }
      }
    },
    "default_workout.crossfit.heroTributeWorkouts.kalsu_2011.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
