    "default_workout.crossfit.heroTributeWorkouts.roy_2013.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Deadlift with a neutral spine and bars close to the body\n• Burpees with an efficient transition\n• Pull-ups with efficient movement (consistent kipping)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Deadlift con columna neutra y barras cerca del cuerpo\n• Burpees con transición eficiente\n• Pull-ups con economía de movimiento (kipping constante)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Deadlift com coluna neutra e barras próximas\n• Burpees com transição eficiente\n• Pull-ups com economia (kipping consistente)"
          }
        }
      }
    },
