          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino pode ser particionado. Estratégia clássica: dividir em séries (ex: 20 rounds de Cindy)."
          }
        }
      }
    },
