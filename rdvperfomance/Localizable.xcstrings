    "default_workout.emCasa.peito.peito_casa.block.1.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Wrist mobility: 30–45s\n• Shoulder external rotation: 2x12 (no load)\n• 2x8 incline push-ups (hand on sofa/table)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Movilidad de muñecas: 30–45s\n• Rotación externa de hombros: 2x12 (sin carga)\n• 2x8 flexiones inclinadas (mano sobre el sofá/mesa)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mobilidade de punho: 30–45s\n• Rotação externa de ombro: 2x12 (sem carga)\n• 2x8 flexões inclinadas (mão no sofá/mesa)"
          }
        }
      }
    },
    "default_workout.emCasa.peito.peito_casa.block.1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm-up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentamiento"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecimento"
          }
        }
      }
    },
    "default_workout.emCasa.peito.peito_casa.block.2.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Body in a straight line (glutes and abs firm)\n• Elbows ~45° from the torso\n• Controlled lowering (2–3s)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Cuerpo en línea recta (glúteos y abdomen firmes)\n• Codos a ~45° del tronco\n• Control en la bajada (2–3s)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Corpo em linha reta (glúteo e abdômen firmes)\n• Cotovelos ~45° do tronco\n• Controle na descida (2–3s)"
          }
        }
      }
    },
    "default_workout.emCasa.peito.peito_casa.block.2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technique"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Técnica"
          }
        }
      }
    },
    "default_workout.emCasa.peito.peito_casa.block.3.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Standard push-up — 4xAMRAP (leave 1–2 reps in reserve)\n2) Diamond (or close-grip) push-up — 3x8–15\n3) Incline push-up (more reps) — 3x12–20\n4) Plank — 3x30–60s\nRest: 45–75s"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Flexión estándar — 4xAMRAP (deja 1–2 reps en reserva)\n2) Flexión diamante (o con agarre cerrado) — 3x8–15\n3) Flexión inclinada (más reps) — 3x12–20\n4) Plancha — 3x30–60s\nDescanso: 45–75s"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1) Flexão padrão — 4xAMRAP (deixe 1–2 reps na reserva)\n2) Flexão diamante (ou fechada) — 3x8–15\n3) Flexão inclinada (mais reps) — 3x12–20\n4) Prancha — 3x30–60s\nDescanso: 45–75s"
          }
        }
      }
    },
    "default_workout.emCasa.peito.peito_casa.block.3.name" : {
