    "default_workout.emCasa.ombros.ombros_casa.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Functional workout focused on the deltoids and stability, with no dumbbells required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento funcional centrado en los deltoides y la estabilidad, sin necesidad de mancuernas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino funcional focado em deltoides e estabilidade, sem necessidade de halteres."
          }
        }
      }
    },
